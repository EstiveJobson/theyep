{
  "name": "theyep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "backend:dev": "tsx watch server/index.ts",
    "backend:start": "tsx server/index.ts",
    "dev:full": "concurrently \"npm:backend:dev\" \"npm:dev\"",
    "start": "tsx server/index.ts",
    "home:server": "powershell -ExecutionPolicy Bypass -File scripts/start-theyep-server.ps1",
    "home:launch": "powershell -ExecutionPolicy Bypass -File scripts/launch-theyep-server.ps1",
    "home:tunnel": "powershell -ExecutionPolicy Bypass -File scripts/launch-cloudflare-tunnel.ps1",
    "home:tunnel:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-cloudflare-tunnel.ps1",
    "home:public": "powershell -ExecutionPolicy Bypass -File scripts/launch-theyep-public.ps1",
    "home:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-theyep-server.ps1",
    "home:status": "powershell -ExecutionPolicy Bypass -File scripts/server-status.ps1",
    "email:configure": "powershell -ExecutionPolicy Bypass -File scripts/configure-smtp.ps1",
    "email:test": "powershell -ExecutionPolicy Bypass -File scripts/test-smtp.ps1",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1046.0",
    "@aws-sdk/s3-request-presigner": "^3.1046.0",
    "@supabase/supabase-js": "^2.105.4",
    "@types/nodemailer": "^8.0.0",
    "busboy": "^1.6.0",
    "lucide-react": "^0.475.0",
    "nodemailer": "^8.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
