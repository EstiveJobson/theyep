# Copie para .env.local na sua máquina.
# No Vercel, cadastre as mesmas chaves em Settings → Environment Variables.
# Nunca commite chave real. Nunca use a service_role no navegador.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# URL pública do site, para Open Graph. Com ou sem https://. A barra final é ignorada.
# Se estiver vazia ou for inválida, o app não quebra: em produção (VERCEL_ENV=production)
# usa https://VERCEL_PROJECT_PRODUCTION_URL, em preview usa https://VERCEL_URL,
# e na máquina local usa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
